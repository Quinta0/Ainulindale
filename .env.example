# Copy to .env next to docker-compose.yml. Everything Ainulindale needs is here.

# --- paths ----------------------------------------------------------------------
MUSIC_PATH=/mnt/user/data/media/music
# CONFIG_PATH=./config          # gluetun/, slskd/, explo/ state + downloaded binaries
TZ=Europe/Zurich
# PUID=99                       # run slskd + Explo as nobody:users instead of root
# PGID=100

# --- VPN (ProtonVPN WireGuard) ----------------------------------------------------
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=10.2.0.2/32
VPN_COUNTRY=Switzerland
PORT_FORWARDING=false           # true if your Proton plan/server supports it

# --- Soulseek / slskd -------------------------------------------------------------
SOULSEEK_USERNAME=
SOULSEEK_PASSWORD=
SLSKD_WEB_USERNAME=admin
SLSKD_WEB_PASSWORD=
# SLSKD_API_KEY=                # generated if empty; set it only to use slskd's API yourself

# --- Navidrome ---------------------------------------------------------------------
NAVIDROME_URL=http://192.168.1.10:4533   # use the LAN IP: the VPN firewall is opened for it automatically
NAVIDROME_USERNAME=
NAVIDROME_PASSWORD=
# FIREWALL_OUTBOUND_SUBNETS=192.168.1.0/24   # only if NAVIDROME_URL is a hostname

# --- discovery sources -------------------------------------------------------------
LISTENBRAINZ_USER=
LISTENBRAINZ_USER_TOKEN=        # required for the discovery mixes (listenbrainz.org/settings)
DISCOVERY_MIXES=weekly          # any of daily,weekly,monthly; weekly:40 sets the track count
# DISCOVERY_AVOID_TAGS=christmas,children's music
# DISCOVERY_PREFER_TAGS=shoegaze,post-rock
# DISCOVERY_ARTIST_COOLDOWN_DAYS=90

# --- schedule & retention ----------------------------------------------------------
DISCOVERY_SCHEDULE=15 0 * * *
RUN_ON_START=false
KEEP_WEEKS=2
PRUNE_FILES=true
KEEP_FAVOURITES=true
PRUNE_LEGACY_JAMS=false

# --- downloading -------------------------------------------------------------------
DOWNLOAD_SERVICES=slskd,youtube
REQUIRE_SLSKD=true
EXTENSIONS=flac,wav,mp3
MIN_BITRATE=320
MIN_BIT_DEPTH=16
# YOUTUBE_API_KEY=
# EXPLO_WEB_UI=false
# EXPLO_WEB_USERNAME=          # required if the Explo UI is on
# EXPLO_WEB_PASSWORD=
# LOG_LEVEL=INFO
